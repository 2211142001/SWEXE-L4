<%= form_with url: '/top/register', data: { turbo: false } do |f| %>
    <p>
        <%= f.label :uid, 'ID' %>
        <%= f.text_field :uid %>
    </p>
    <p>
        <%= f.label :pass, 'パスワード' %>
        <%= f.password_field :pass %>
    </p>
    <%= f.submit '登録' %>
<% end %>

<%= link_to 'ログイン', main_path %>